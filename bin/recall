#!/usr/bin/env python3
"""recall — session memory & orchestration layer for Claude Code.

One index of all your AI coding sessions. Find a past session by what you
were doing, inspect its recap card, and act on it three ways:

  finish   — dive in and finish the task in the current Claude session
  handoff  — print the resume command to run yourself      (recall cmd)
  spawn    — open a new terminal window with the session   (recall open)

Data lives in ~/.claude/session-recaps/ (override: RECALL_DATA):
  INDEX.md        one line per session — the single searchable touchpoint
  <id>.md         recap card: task, status, method, entities, artifacts, next
  handoffs/<id>.md  in-flight state card, written before compaction / at session
                    end; re-injected on SessionStart(compact|resume) so a session
                    wakes up knowing exactly where it left off
"""
import fcntl
import glob
import json
import os
import re
import subprocess
import sys

VERSION = "0.6.0"
DATA = os.environ.get("RECALL_DATA", os.path.expanduser("~/.claude/session-recaps"))
MODEL = os.environ.get("RECALL_MODEL", "claude-haiku-4-5-20251001")
MIN_EVENTS = int(os.environ.get("RECALL_MIN_EVENTS", "15"))
PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
RECAP_MARKER = "SESSION-RECAP-WORKER"  # recap worker sessions carry it; never recap them
# NOT /tmp: macOS clears it on reboot — the error history died with the same
# reboot that killed the sessions it would have explained
LOG = os.path.expanduser(os.environ.get("RECALL_LOG", "~/.claude/recall/recall.log"))
REMOVED = os.path.join(DATA, ".removed")  # id8 per line; recap/backfill skip these
HANDOFFS = os.path.join(DATA, "handoffs")
HANDOFF_DAYS = int(os.environ.get("RECALL_HANDOFF_DAYS", "30"))
AUTONAMED = os.path.join(DATA, ".autonamed")  # id8 per line; titles we set (manual ones are sacred)
AUTONAME = os.environ.get("RECALL_AUTONAME", "1") != "0"
SESSIONS_DIR = os.path.expanduser("~/.claude/sessions")
ARCHIVE = os.path.expanduser(os.environ.get("RECALL_ARCHIVE", "~/backups/claude-transcripts"))  # durable, append-only transcript backup OUT of the prune zone
ITERMQ = os.path.expanduser("~/.claude/recall/itermq")            # iTerm bridge job queue (0700); must match iterm_bridge.py
ITERM_AUDIT = os.path.expanduser("~/.claude/recall/iterm-audit.log")

# fallback dirs only — appended, so the user's PATH order always wins
for d in ("~/.npm-global/bin", "/opt/homebrew/bin", "/usr/local/bin", "~/.local/bin"):
    p = os.path.expanduser(d)
    if p not in os.environ.get("PATH", ""):
        os.environ["PATH"] = os.environ.get("PATH", "") + os.pathsep + p


# ── transcript -> digest ────────────────────────────────────────────────

def parse_transcript(path):
    user_msgs, ai_texts, skills, urls = [], [], set(), []
    cwd = first_ts = last_ts = None
    n = 0
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            n += 1
            if not cwd and e.get("cwd"):
                cwd = e["cwd"]
            ts = e.get("timestamp")
            if ts:
                first_ts = first_ts or ts
                last_ts = ts
            content = (e.get("message") or {}).get("content")
            if e.get("type") == "user" and isinstance(content, str):
                if RECAP_MARKER in content:
                    return None
                m = re.search(r"skills/([a-z0-9-]+)", content)
                if m:
                    skills.add(m.group(1))
                if not content.startswith("<task-notification>"):
                    user_msgs.append(content)
            elif e.get("type") == "assistant" and isinstance(content, list):
                for block in content:
                    if block.get("type") == "text" and block.get("text"):
                        ai_texts.append(block["text"])
                        urls += re.findall(r"https?://[^\s)\"'>\]]+", block["text"])
    if not user_msgs and not ai_texts:
        return None
    seen = set()
    urls = [u for u in urls if not (u in seen or seen.add(u))]
    urls.sort(key=lambda u: 0 if re.search(r"docs\.google|sheets|pages\.dev|notion", u) else 1)
    return {"cwd": cwd or "?", "first_ts": (first_ts or "")[:10], "last_ts": (last_ts or "")[:10],
            "last_iso": last_ts or "", "n": n, "skills": sorted(skills), "urls": urls[:8],
            "user_msgs": user_msgs, "ai_texts": ai_texts}


def ts_local(iso):
    """ISO UTC timestamp -> local sortable 'YYYY-MM-DDTHH:MM'. Time-of-day in the
    index is what breaks same-day ties between sessions of one project — date-only
    lines made `find` pick an arbitrary (often older) sibling."""
    from datetime import datetime
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%dT%H:%M")
    except ValueError:
        return (iso or "")[:10]


def build_digest(t, tail=False):
    cut = lambda s, k: s[:k] + ("…" if len(s) > k else "")
    parts = [f"Project (cwd): {t['cwd']}", f"Span: {t['first_ts']} -> {t['last_ts']}, events: {t['n']}"]
    if t["skills"]:
        parts.append("Skills invoked: " + ", ".join(t["skills"]))
    if t["urls"]:
        parts.append("URLs in replies: " + " ".join(t["urls"]))
    if tail:  # handoff: the end of the session is what matters
        parts.append("\n-- FIRST USER REQUESTS --")
        parts += [cut(m, 400) for m in t["user_msgs"][:3]]
        parts.append("\n-- LAST USER REQUESTS --")
        parts += [cut(m, 400) for m in t["user_msgs"][-6:]]
        parts.append("\n-- LAST ASSISTANT REPLIES --")
        parts += [cut(m, 600) for m in t["ai_texts"][-8:]]
        return cut("\n".join(parts), 14000)
    parts.append("\n-- FIRST USER REQUESTS --")
    parts += [cut(m, 500) for m in t["user_msgs"][:5]]
    if len(t["user_msgs"]) > 7:
        parts.append("\n-- LAST USER REQUESTS --")
        parts += [cut(m, 300) for m in t["user_msgs"][-2:]]
    parts.append("\n-- LAST ASSISTANT REPLIES --")
    parts += [cut(m, 500) for m in t["ai_texts"][-5:]]
    return cut("\n".join(parts), 12000)


# ── recap generation ────────────────────────────────────────────────────

def run_claude(prompt):
    r = subprocess.run(["claude", "-p", prompt, "--model", MODEL],
                       capture_output=True, text=True, timeout=180, cwd=DATA)
    if r.returncode != 0:
        raise RuntimeError(f"claude -p failed: {r.stderr[:300]}")
    return re.sub(r"^```[a-z]*\n?|\n?```$", "", r.stdout.strip()).strip()


def tag_vocab():
    """Curated tag vocabulary from DATA/TAGS.md (lines starting with #tag)."""
    p = os.path.join(DATA, "TAGS.md")
    if not os.path.exists(p):
        return []
    return re.findall(r"^#([\wЀ-ӿ-]+)", open(p, encoding="utf-8").read(), re.M)


def call_llm(digest):
    vocab = tag_vocab()
    vhint = ("; PREFER these existing tags: " + " ".join("#" + v for v in vocab[:60])) if vocab else ""
    prompt = f"""[{RECAP_MARKER}] Generate a recap card for an AI coding session. Output strict YAML only — no markdown fences, no commentary. Write task/method/next in the SAME language the session itself is in. entities/tags/artifacts MUST be one-line flow lists like [a, b]. Fields:
task: one line — what the task was (concretely: who/what/for whom)
status: done | in_progress | aborted
method: how it was solved (skill/script/approach), one line; null if unclear
entities: [people, companies, systems mentioned — for search]
tags: [1-3 lowercase kebab-case topic tags{vhint}]
artifacts: [only actually produced results — sheet/page URLs, file paths]
next: what remains to be done, one line; null if complete

Session digest:
{digest}"""
    return run_claude(prompt)


def yaml_list(text, key):
    """Value of a YAML list field as 'a, b' — BOTH flow style (`key: [a, b]`) and
    block style (`key:` + `  - a` lines). haiku emits either; the old flow-only
    regex silently dropped entities from 2/3 of index lines, gutting search."""
    m = re.search(rf"^{key}:\s*\[(.*?)\]", text, re.M | re.S)
    if m:
        return " ".join(m.group(1).split())
    m = re.search(rf"^{key}:\s*\n((?:[ \t]+-[^\n]*\n?)+)", text, re.M)
    if not m:
        return ""
    items = [re.sub(r"^\s*-\s*", "", l).strip().strip("'\"") for l in m.group(1).splitlines()]
    return ", ".join(i for i in items if i)


def norm_tag(s):
    s = re.sub(r"[\s_]+", "-", s.strip().strip("'\"#«»").lower())
    return re.sub(r"[^\wЀ-ӿ-]", "", s)


def is_meta(t, task=""):
    """A session ABOUT finding/driving other sessions (orchestrator). Its recap
    carries the very keywords being searched («найти сессию про портал…») and
    shadows the real work session in `find` — mark it so the scorer demotes it."""
    if "session-orchestrator" in t.get("skills", ()):
        return True
    if re.search(r"(найти|найди|восстанови|возобнови|подними|открой|открыть|resume|find)\w*\s+"
                 r"(мне\s+)?сесси", task, re.I):
        return True
    return any(re.search(r"\brecall (find|open|cmd|send|peek)\b", x) for x in t.get("ai_texts", ()))


def index_line(session_id, t, yaml_text):
    grab = lambda k: (re.search(rf"^{k}:\s*(.+)$", yaml_text, re.M) or [None, ""])[1].strip()
    ents = yaml_list(yaml_text, "entities")
    tags = " ".join(f"#{norm_tag(x)}" for x in yaml_list(yaml_text, "tags").split(",") if norm_tag(x))
    # underscores keep the project a single token: «Колл Центр » split the column
    proj = re.sub(r"\s+", "_", os.path.basename(t["cwd"].rstrip("/")) or t["cwd"])
    stamp = ts_local(t["last_iso"]) if t.get("last_iso") else t["last_ts"]
    meta = "(meta) " if is_meta(t, grab("task")) else ""
    return (f"{session_id[:8]} {stamp} {proj} [{grab('status') or '?'}] {meta}"
            f"{grab('task')}{' ' + tags if tags else ''} {{{ents}}}")


def update_index(session_id, line):
    with open(os.path.join(DATA, "INDEX.md"), "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        lines = [l for l in f.read().splitlines() if l.strip() and not l.startswith(session_id[:8])]
        lines.append(line)
        f.seek(0)
        f.truncate()
        f.write("\n".join(lines) + "\n")


def removed_ids():
    if not os.path.exists(REMOVED):
        return set()
    return {l.strip()[:8] for l in open(REMOVED, encoding="utf-8") if l.strip()}


def cmd_recap(transcript, force=False):
    os.makedirs(DATA, exist_ok=True)
    session_id = os.path.basename(transcript).replace(".jsonl", "")
    card_path = os.path.join(DATA, f"{session_id}.md")
    if session_id[:8] in removed_ids():
        if not force:
            print(f"skip {session_id[:8]} (removed; use --force to re-index)")
            return
        keep = [i for i in removed_ids() if i != session_id[:8]]
        with open(REMOVED, "w", encoding="utf-8") as f:
            f.write("\n".join(keep) + ("\n" if keep else ""))
    if os.path.exists(card_path) and not force \
            and os.path.getmtime(card_path) >= os.path.getmtime(transcript):
        if AUTONAME and session_id[:8] not in autonamed_ids():
            # title already-recapped sessions from their card — no LLM call
            meta = card_meta(card_path)
            m = re.search(r"^task:\s*(.+)$", meta["text"], re.M)
            if m:
                apply_title(transcript, session_title(meta["project"], m.group(1)))
        print(f"skip {session_id[:8]} (up to date)")
        return
    t = parse_transcript(transcript)
    if t is None:
        print(f"skip {session_id[:8]} (empty or recap-worker session)")
        return
    yaml_text = call_llm(build_digest(t))
    if AUTONAME:  # title BEFORE the card: keeps card mtime >= transcript mtime
        m = re.search(r"^task:\s*(.+)$", yaml_text, re.M)
        if m:
            apply_title(transcript, session_title(t["cwd"], m.group(1)))
    with open(card_path, "w", encoding="utf-8") as f:
        f.write(f"---\nid: {session_id}\nproject: {t['cwd']}\ndates: {t['first_ts']} -> {t['last_ts']}\n"
                f"messages: {t['n']}\n{yaml_text}\n---\n")
    update_index(session_id, index_line(session_id, t, yaml_text))
    print(f"ok {session_id[:8]}")


# ── auto-naming (sessions title themselves: папка/проект · задача) ─────

def autonamed_ids():
    if not os.path.exists(AUTONAMED):
        return set()
    return {l.strip()[:8] for l in open(AUTONAMED, encoding="utf-8") if l.strip()}


def project_prefix(cwd):
    """Short project tag = the project's own folder name. Used for BOTH the title
    prefix and the per-project tab colour, so naming and colour stay in sync."""
    parts = [p for p in (cwd or "").split("/") if p]
    return (parts[-1].strip() if parts else "") or "?"


# one stable, distinct icon per project — a visual anchor in the tab bar / listings
EMOJI_PALETTE = [
    "🚀", "🧩", "📦", "⚙️", "🧪", "🛰️", "🗂️", "🔭", "🧱", "🎯", "🔬", "🗺️",
    "🧰", "🔧", "🪄", "🎛️", "🛎️", "🚂", "🧭", "📡", "🦊", "🐙", "🦉", "🌶️",
]


def project_emoji(cwd):
    import zlib
    key = project_prefix(cwd)  # stable per folder, just like the colour
    return EMOJI_PALETTE[zlib.crc32(("emoji:" + key).encode()) % len(EMOJI_PALETTE)]


# leading action-verbs / question-words / connectors that waste the 1–2 word task slot —
# drop them so the tab shows the meaningful noun («MCP-сервис»), not «создать…»/«почему…»
TASK_STOPWORDS = {
    # ru: leading verbs
    "создать", "создай", "сделать", "сделай", "разработка", "разработать", "разработай",
    "настроить", "настройка", "починить", "чинить", "добавить", "выбрать", "исследовать",
    "изучить", "реализовать", "написать", "обновить", "проверить", "ковать", "куём", "куем",
    "исправить", "исправление", "исправь", "доработать", "доработка", "доработай",
    # ru: question/fillers/connectors
    "почему", "как", "что", "чтобы", "для", "на", "в", "с", "по", "при", "из", "о", "об",
    "и", "а", "но", "же", "ли", "бы", "не", "это",
    # en
    "the", "a", "an", "to", "of", "for", "why", "how", "what", "fix", "build", "create",
    "make", "add", "setup", "set", "update", "implement", "write", "debug", "investigate",
}


def short_task(task, n=2):
    """Up to n *content* words from the task summary — drop a trailing process tag «(bun)»,
    then skip filler verbs / question-words / connectors ANYWHERE so the slot holds real nouns:
    «разработка pipeline проверок» → «pipeline проверок», «Диагностика и исправление выгрузки»
    → «Диагностика выгрузки», «Интеграция с Tochka API» → «Интеграция Tochka». Negations are
    never dropped so «сайт не открывается» keeps its meaning."""
    norm = lambda w: w.lower().strip("«».,!?\"'()[]")
    keep_always = {"не", "нет", "ни", "not", "no"}                 # never swallow a negation
    task = re.sub(r"\s*\([^)]*\)\s*$", "", (task or "").strip())   # strip a trailing (bun)/(mcp) tag
    words = [w for w in re.split(r"[\s—–:;,/]+", task) if w]
    content = [w for w in words if norm(w) in keep_always or norm(w) not in TASK_STOPWORDS]
    picked = [w.strip("«».,!?\"'`()[]") for w in (content or words)[:n]]   # no leaked «"» edges
    return " ".join(w for w in picked if w)


# tiny fixed codes for the projects juggled daily — the folder name is the column
# hog (e.g. «Rosperevozki_сделки» = 19 cols), so collapse it to 2–3 cols and hand the
# rest to the task. Matched as a case-insensitive keyword anywhere in the folder name;
# more specific keys first so a sub-folder wins over its parent project.
FOLDER_ALIASES = [
    ("коллцентр", "КЦ"), ("колцентр", "КЦ"), ("callcenter", "КЦ"), ("call-center", "КЦ"),
    ("rosperevozki", "RP"), ("росперевозки", "RP"),
    ("welly", "WL"), ("велли", "WL"),
    ("n8n", "N8N"),
]


def folder_alias(name):
    """Collapse a known project folder to its tiny code (Rosperevozki_сделки → RP,
    «Колл Центр » → КЦ). Separators are ignored on both sides so spacing/case never
    breaks the match. Unknown folders pass through for short_folder() to size down."""
    squash = lambda s: re.sub(r"[\s_\-]+", "", (s or "").lower())
    low = squash(name)
    for key, code in FOLDER_ALIASES:
        if squash(key) in low:
            return code
    return (name or "").strip()


def short_folder(name, max_len):
    """Map known projects to a tiny code (Rosperevozki→RP, коллцентр→КЦ, welly→WL) so the
    task gets the columns; unknown folders fall back to whole/first-word/truncated."""
    name = folder_alias(name)
    if len(name) <= max_len:
        return name
    first = name.split()[0] if name.split() else name
    if len(first) <= max_len:
        return first
    return first[:max(1, max_len - 1)].rstrip() + "…"


def session_title(cwd, task, limit=30):
    # «<эмодзи> <папка> · <задача 1–2 словами>» — emoji + colour stable per project;
    # BOTH parts kept short so the iTerm tab bar stays readable and the task survives.
    sep = " · "
    icon = project_emoji(cwd)
    head = f"{icon} " if icon else ""
    body_limit = limit - 3            # emoji renders ~2 cols + 1 space — reserve for it
    folder = short_folder(project_prefix(cwd), body_limit - len(sep) - 11)  # leave ≥11 for task
    task = short_task(task)
    if not task:
        return head + folder[:body_limit]
    budget = body_limit - len(folder) - len(sep)
    if len(task) > budget:
        task = (task[:budget - 1].rstrip() + "…") if budget > 1 else ""
    body = f"{folder}{sep}{task}" if task else folder
    return head + body[:body_limit]


def registry_entries(session_id):
    for p in glob.glob(os.path.join(SESSIONS_DIR, "*.json")):
        try:
            d = json.load(open(p, encoding="utf-8"))
        except Exception:
            continue
        if d.get("sessionId") == session_id:
            yield p, d


def apply_title(transcript, title, manual=False):
    """Rename a session the way /rename does: append custom-title + agent-name
    records to its transcript, sync the live-session registry if it's running."""
    session_id = os.path.basename(transcript).replace(".jsonl", "")
    if not manual and session_id[:8] not in autonamed_ids():
        # a title the USER set (via /rename, claude -n, ...) is never overwritten
        named = subprocess.run(["grep", "-q", '"type":"custom-title"', transcript],
                               capture_output=True).returncode == 0
        named = named or any(d.get("name") for _, d in registry_entries(session_id))
        if named:
            return False
    with open(transcript, "a", encoding="utf-8") as f:
        for typ, key in (("custom-title", "customTitle"), ("agent-name", "agentName")):
            f.write(json.dumps({"type": typ, key: title, "sessionId": session_id},
                               ensure_ascii=False) + "\n")
    for p, d in registry_entries(session_id):
        d["name"] = title
        json.dump(d, open(p, "w", encoding="utf-8"), ensure_ascii=False)
    card = os.path.join(DATA, f"{session_id}.md")
    if os.path.exists(card):
        os.utime(card)  # we just touched the transcript; keep the card "up to date"
    with open(AUTONAMED, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        marks = {l.strip()[:8] for l in f.read().splitlines() if l.strip()}
        (marks.discard if manual else marks.add)(session_id[:8])
        f.seek(0)
        f.truncate()
        f.write("\n".join(sorted(marks)) + ("\n" if marks else ""))
    print(f"title {session_id[:8]} -> {title}")
    return True


def find_transcript(id_prefix):
    full_id = card_meta(resolve_card(id_prefix))["id"]
    hits = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{full_id}.jsonl"))
    if not hits:
        sys.exit(f"recall: no transcript on disk for {full_id}")
    return hits[0]


# ── handoff layer (continuity across compaction / resume) ──────────────

def cmd_handoff(transcript):
    import time
    os.makedirs(HANDOFFS, exist_ok=True)
    session_id = os.path.basename(transcript).replace(".jsonl", "")
    t = parse_transcript(transcript)
    if t is None:
        print(f"skip {session_id[:8]} (empty or recap-worker session)")
        return
    prompt = f"""[{RECAP_MARKER}] Write a HANDOFF for an AI coding session that is about to be context-compacted (or has just ended). The session's next context window reads it to continue seamlessly. Output plain markdown, no fences, max 25 lines, in the SAME language the session is in. Keep these exact bold section headers:
**Task now:** one line — what is being worked on right now
**Done:** 3-6 bullets of completed work (concrete: file paths, URLs, commands)
**In flight:** what is mid-flight (files being edited, uncommitted changes, running processes); "-" if none
**Next:** numbered exact next steps
**Gotchas:** pitfalls discovered this session; "-" if none

Session digest:
{build_digest(t, tail=True)}"""
    text = run_claude(prompt)
    if AUTONAME:  # the task evolves — refresh the session's title at each compact
        m = re.search(r"\*\*Task now:\*\*\s*(.+)", text)
        if m:
            apply_title(transcript, session_title(t["cwd"], m.group(1)))
    path = os.path.join(HANDOFFS, f"{session_id}.md")
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"# Session handoff (auto-written before last compact / at session end)\n"
                f"id: {session_id} | project: {t['cwd']} | updated: {time.strftime('%Y-%m-%d %H:%M')}\n\n"
                f"{text}\n")
    print(f"handoff {session_id[:8]} -> {path}")


def handoff_enabled():
    """The handoff loop is opt-in: it's on iff its hooks are in settings.json."""
    settings = os.path.expanduser("~/.claude/settings.json")
    try:
        return "recall restore-hook" in open(settings, encoding="utf-8").read()
    except OSError:
        return False


def prune_handoffs(days=HANDOFF_DAYS):
    import time
    cutoff = time.time() - days * 86400
    for p in glob.glob(os.path.join(HANDOFFS, "*.md")):
        if os.path.getmtime(p) < cutoff:
            os.remove(p)


def last_activity(path):
    """Epoch of the transcript's last real event. File mtime lies here: recall
    itself appends title records to old transcripts, bumping their mtime — so
    a --days filter on mtime would resurrect ancient sessions. Event timestamps
    can't lie: our appended records carry none."""
    from datetime import datetime
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode("utf-8", errors="replace")
        stamps = re.findall(r'"timestamp"\s*:\s*"([^"]+)"', tail)
        if stamps:
            return datetime.fromisoformat(stamps[-1].replace("Z", "+00:00")).timestamp()
    except (OSError, ValueError):
        pass
    return os.path.getmtime(path)


def cmd_handoff_all(days=14, jobs=4):
    """Retro-sweep: write handoff cards for recent sessions that lack one."""
    from concurrent.futures import ThreadPoolExecutor
    import time
    cutoff = time.time() - days * 86400
    removed, targets = removed_ids(), []
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        sid = os.path.basename(path).replace(".jsonl", "")
        # mtime only ever overstates recency — cheap reject before reading the tail
        if sid.startswith("agent-") or os.path.getmtime(path) < cutoff:
            continue
        if sid[:8] in removed or os.path.exists(os.path.join(HANDOFFS, f"{sid}.md")):
            continue
        if last_activity(path) < cutoff:
            continue
        with open(path, errors="replace") as f:
            if sum(1 for _ in f) >= MIN_EVENTS:
                targets.append(path)
    print(f"handoff backfill: {len(targets)} sessions (days<={days}, jobs={jobs}, "
          f"one haiku call each)", flush=True)
    with ThreadPoolExecutor(max_workers=jobs) as ex:
        for fut in [ex.submit(cmd_handoff, t) for t in targets]:
            try:
                fut.result()
            except Exception as e:
                print(f"error: {e}", file=sys.stderr)
    print("handoff backfill done")


def cmd_handoff_hook():
    """PreCompact entrypoint: synchronous — the handoff must exist before the
    post-compact SessionStart fires. Never blocks compaction on error."""
    try:
        transcript = json.load(sys.stdin).get("transcript_path", "")
    except Exception:
        return
    if not os.path.isfile(transcript):
        return
    archive_one(transcript)  # back up immediately (SessionEnd/PreCompact), before any cleanup can delete it
    with open(transcript, errors="replace") as f:
        if sum(1 for _ in f) < MIN_EVENTS:
            return
    try:
        cmd_handoff(transcript)
        prune_handoffs()
    except Exception as e:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as log:
            log.write(f"handoff-hook: {e}\n")


def cmd_restore_hook():
    """SessionStart(compact|resume) entrypoint: stdout becomes session context."""
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    ids = [payload.get("session_id", ""),
           os.path.basename(payload.get("transcript_path", "")).replace(".jsonl", "")]
    for sid in ids:
        path = os.path.join(HANDOFFS, f"{sid}.md")
        if sid and os.path.isfile(path):
            sys.stdout.write(open(path, encoding="utf-8").read())
            return


# ── card lookup ─────────────────────────────────────────────────────────

def resolve_card(id_prefix):
    hits = [p for p in glob.glob(os.path.join(DATA, f"{id_prefix}*.md")) if not p.endswith("INDEX.md")]
    if not hits:
        sys.exit(f"recall: no card for id '{id_prefix}' (try: recall find <query>)")
    if len(hits) > 1:
        sys.exit("recall: ambiguous id, matches:\n  " + "\n  ".join(os.path.basename(h)[:8] for h in hits))
    return hits[0]


def card_meta(path):
    text = open(path, encoding="utf-8").read()
    grab = lambda k: (re.search(rf"^{k}:\s*(.+)$", text, re.M) or [None, ""])[1].strip()
    return {"id": grab("id"), "project": grab("project"), "text": text}


def resume_command(id_prefix):
    m = card_meta(resolve_card(id_prefix))
    return f'cd "{m["project"]}" && claude --resume {m["id"]}'


# ── commands ────────────────────────────────────────────────────────────

def live_sessions():
    """sessionId -> pid for sessions whose Claude process is ALIVE right now.
    ~/.claude/sessions/<pid>.json entries outlive their process (stale after a
    crash/reboot, pids get reused), so require the pid to be running AND still
    look like a claude/node process."""
    reg = {}
    for p in glob.glob(os.path.join(SESSIONS_DIR, "*.json")):
        pid = os.path.basename(p).split(".")[0]
        if not pid.isdigit():
            continue
        try:
            sid = json.load(open(p, encoding="utf-8")).get("sessionId")
        except Exception:
            continue
        if sid:
            reg[int(pid)] = sid
    if not reg:
        return {}
    try:
        r = subprocess.run(["/bin/ps", "-p", ",".join(map(str, reg)), "-o", "pid=,comm="],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit() and re.search(r"(claude|node)", parts[1]):
            out[reg[int(parts[0])]] = int(parts[0])
    return out


def cmd_find(terms):
    """Scored search, not plain OR: task words weigh 3, #tags/{entities} 2, project 1;
    (meta)/#meta lines are demoted so «найди сессию…» finder-sessions never shadow
    the real work. Live sessions are flagged ⚡LIVE — resume those and you fork them."""
    idx = os.path.join(DATA, "INDEX.md")
    if not os.path.exists(idx):
        sys.exit("recall: no index yet — run `recall sweep` first")
    live8 = {s[:8] for s in live_sessions()}
    terms_l = [t.lower() for t in terms]
    scored = []
    for l in open(idx, encoding="utf-8"):
        if not l.strip():
            continue
        parts = l.split()
        proj = parts[2].lower() if len(parts) > 2 else ""
        tagzone = " ".join(re.findall(r"#[\wЀ-ӿ-]+", l)).lower()
        m = re.search(r"\{(.*)\}", l)
        tagzone += " " + (m.group(1).lower() if m else "")
        taskzone = re.sub(r"\{.*\}|#[\wЀ-ӿ-]+", "", l.split("]", 1)[1] if "]" in l else l).lower()
        score = 0
        for t in terms_l:
            if t in taskzone:
                score += 3
            elif t in tagzone:
                score += 2
            elif t in proj:
                score += 1
        if score and ("(meta)" in l or "#meta" in tagzone):
            score -= 2  # a strong task match still surfaces, weak ones drop
        if score <= 0:
            continue
        date = parts[1] if len(parts) > 1 else ""
        scored.append((score, date, l.rstrip() + ("  ⚡LIVE" if parts[0] in live8 else "")))
    scored.sort(key=lambda x: (x[0], x[1]), reverse=True)
    if not scored:
        print("no matches in index; try other word stems, or full-text:\n"
              f"  recall grep {' '.join(terms)}")
        return
    for s, d, l in scored[:25]:
        print(l)
    if len(scored) > 25:
        print(f"(+{len(scored) - 25} more)")


def cmd_grep(terms):
    """Full-text fallback over raw transcripts — a minimal nod to codbash."""
    import shutil
    import time
    pats = [x for t in terms for x in ("-e", t)]
    if shutil.which("rg"):  # ripgrep if available: ~10x faster on GBs of transcripts
        r = subprocess.run(["rg", "-liF", "--no-messages", "-g", "*.jsonl",
                            "-g", "!agent-*"] + pats + [PROJECTS_DIR],
                           capture_output=True, text=True)
        files = r.stdout.splitlines()
    else:  # parallel grep across cores
        paths = subprocess.run(["find", PROJECTS_DIR, "-name", "*.jsonl",
                                "!", "-name", "agent-*", "-print0"],
                               capture_output=True, text=True).stdout
        r = subprocess.run(["xargs", "-0", "-P", str(os.cpu_count() or 4), "-n", "32",
                            "grep", "-liF"] + pats, input=paths,
                           capture_output=True, text=True)
        files = r.stdout.splitlines()
    if not files:
        sys.exit(f"recall: no full-text matches for: {' '.join(terms)}")
    files.sort(key=os.path.getmtime, reverse=True)
    pat = re.compile("|".join(re.escape(t) for t in terms), re.I)
    grep1 = lambda args, path: subprocess.run(["grep", "-m1"] + args + [path],
                                              capture_output=True, text=True).stdout
    for path in files[:15]:
        sid = os.path.basename(path).replace(".jsonl", "")[:8]
        date = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(path)))
        m = re.search(r'"cwd":\s*"([^"]+)"', grep1(['"cwd"'], path))
        proj = os.path.basename(m.group(1).rstrip("/")) if m else "?"
        line = grep1(["-iF"] + [x for t in terms for x in ("-e", t)], path)
        m, snippet = pat.search(line), ""
        if m:
            s = max(0, m.start() - 60)
            snippet = line[s:m.end() + 80].replace("\\n", " ").replace('\\"', '"')
        print(f"{sid} {date} {proj} … {snippet.strip()} …")
    if len(files) > 15:
        print(f"(+{len(files) - 15} more sessions matched)")


def _migrate_to_dev(cwd):
    """Folders moved out of ~/Documents (macOS TCC blocks reading them) into ~/dev.
    Remap a recorded cwd to its ~/dev twin IF that twin actually exists, so resuming an
    old session opens in the new, accessible spot. Mirrors the path, dropping a legacy
    'Cursor/' level if present. Non-moved folders keep their original path untouched.
    Add a new mapping = just move the folder to the mirrored ~/dev path; this auto-picks it up."""
    if not cwd or "/Documents/" not in cwd:
        return cwd
    for cand in (cwd.replace("/Documents/Cursor/", "/dev/", 1),
                 cwd.replace("/Documents/", "/dev/", 1)):
        if cand != cwd and os.path.isdir(cand):
            return cand
    return cwd


def _session_cwd(jsonl_path):
    """The exact cwd claude recorded for a session — authoritative for `--resume`.
    The YAML card strips trailing spaces from `project:`, which silently breaks `cd`
    into folders like «Колл Центр » (trailing space) and resumes the wrong sibling."""
    try:
        with open(jsonl_path, encoding="utf-8", errors="ignore") as f:
            for line in f:
                mm = re.search(r'"cwd"\s*:\s*"((?:[^"\\]|\\.)*)"', line)
                if mm:
                    return _migrate_to_dev(json.loads('"' + mm.group(1) + '"'))
    except Exception:
        return None
    return None


def _live_guard(sid, force):
    """True = stop: this session's claude is RUNNING somewhere right now. A second
    `--resume` of a live session double-writes its jsonl and forks the context —
    the classic «восстановили не ту / контекст откатился» corruption."""
    if force:
        return False
    pid = live_sessions().get(sid)
    if not pid:
        return False
    print(f"⚠ сессия {sid[:8]} УЖЕ ОТКРЫТА (pid {pid}) — второй resume раздвоит её контекст.")
    print("  Адресно: recall ps → recall peek/send <tty>. Всё равно открыть: recall open "
          f"{sid[:8]} --force")
    return True


def cmd_open(id_prefix, fast=False, tab=False, force=False):
    # resolve via recall card when one exists; otherwise fall back to a cardless
    # resume by raw jsonl id (forks and freshly-spawned sessions have no card yet).
    try:
        m = card_meta(resolve_card(id_prefix))
        sid = m["id"]
    except (Exception, SystemExit):  # resolve_card sys.exit()s when cardless — fall through to raw-jsonl/orphan path
        m, sid = None, None
    if m is None:
        g = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{id_prefix}*.jsonl"))
        if not g or not os.path.exists(g[0]):
            print(f"open: no live transcript for '{id_prefix}'.")
            rep = orphan_artifacts(id_prefix)
            if rep:
                print("the .jsonl is gone — reconstruct from what survived, don't expect a resume:\n" + rep)
            else:
                print("nothing found under ~/.claude/projects for that id.")
            return
        sid = os.path.basename(g[0])[:-len(".jsonl")]
        if _live_guard(sid, force):
            return
        tr = [g[0]]
        project = _session_cwd(g[0]) or ""
        if not project:
            print(f"open: cannot determine cwd for '{sid[:8]}'"); return
        title = session_title(project, "сессия")
    else:
        if _live_guard(sid, force):
            return
        tr = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
        if not tr:
            print(f"⚠ recall: card exists for {sid[:8]} but its transcript .jsonl is DELETED "
                  "— a resume would open a BLANK session. Not opening.")
            rep = orphan_artifacts(sid)
            if rep:
                print("surviving artifacts (reconstruct context from these):\n" + rep)
            return
        if not fast and not os.path.exists(os.path.join(HANDOFFS, f"{sid}.md")):
            if tr:
                print("no handoff card — writing one so the session wakes up informed "
                      "(~30s, one haiku call; skip with --fast)")
                try:
                    cmd_handoff(tr[0])
                except Exception as e:
                    print(f"  handoff failed ({e}) — opening anyway")
        # prefer the jsonl's exact cwd (preserves trailing spaces) over the YAML-stripped card
        project = (_session_cwd(tr[0]) if tr else None) or m["project"]
        tm = re.search(r"^task:\s*(.+)$", m.get("text", ""), re.M)
        title = session_title(project, tm.group(1) if tm else "")
    shell_cmd = f'cd "{project}" && claude --resume {sid}'
    # RECALL_CLAUDE_FLAGS: extra flags appended to `claude` (before any seed prompt),
    # e.g. "--dangerously-skip-permissions". Flags precede the positional prompt arg.
    flags = os.environ.get("RECALL_CLAUDE_FLAGS")
    if flags:
        shell_cmd += f" {flags}"
    # optional seed prompt: RECALL_SEED_FILE points at a text file whose contents are
    # passed as claude's initial prompt, so the resumed session wakes up already knowing
    # the new task. cat runs in the spawned shell, so the prompt body never touches the
    # AppleScript layer (no escaping headaches); only the simple "$(cat '...')" wrapper does.
    seed = os.environ.get("RECALL_SEED_FILE")
    if seed and os.path.exists(seed):
        shell_cmd += f" \"$(cat '{seed}')\""
    open_in_terminal(shell_cmd, tab=tab, project=project, title=title)


def cmd_fork(id_prefix, at_line=None, anchor=None, tab=False, task="форк"):
    """Branch a NEW session from an existing one at a chosen transcript line.
    Copies the prefix (lines 1..cut) into a fresh session UUID, rewriting the
    sessionId so `claude --resume` treats it as its own branch; the original is
    untouched. Use it to peel a still-relevant thread off a conversation that
    later drifted elsewhere. The session UUID appears only as `sessionId` (message
    uuids differ), so a plain string-swap rewrites exactly the right field.
    RECALL_SEED_FILE still works → the fork wakes with an initial prompt."""
    import uuid as _uuid
    g = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{id_prefix}*.jsonl"))
    if not g:
        try:
            m = card_meta(resolve_card(id_prefix))
            g = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{m['id']}.jsonl"))
        except Exception:
            g = []
    if not g or not os.path.exists(g[0]):
        print(f"fork: session jsonl for '{id_prefix}' not found"); return None
    src = g[0]
    old_id = os.path.basename(src)[:-len(".jsonl")]
    cut = at_line
    if cut is None and anchor:
        with open(src, encoding="utf-8", errors="ignore") as f:
            for i, line in enumerate(f, 1):
                if anchor in line:
                    cut = i  # last line containing the anchor
    if not cut:
        print("fork: need --at-line N (or --anchor TEXT)"); return None
    new_id = str(_uuid.uuid4())
    dst = os.path.join(os.path.dirname(src), new_id + ".jsonl")
    n = 0
    with open(src, encoding="utf-8", errors="ignore") as f, \
         open(dst, "w", encoding="utf-8") as o:
        for i, line in enumerate(f, 1):
            if i > cut:
                break
            o.write(line.replace(old_id, new_id))
            n += 1
    project = _session_cwd(dst) or _session_cwd(src) or ""
    title = session_title(project, task) if project else None
    print(f"forked {old_id[:8]} → {new_id[:8]}  ({n} lines, cut @ {cut})  {project}")
    shell_cmd = f'cd "{project}" && claude --resume {new_id}'
    flags = os.environ.get("RECALL_CLAUDE_FLAGS")
    if flags:
        shell_cmd += f" {flags}"
    seed = os.environ.get("RECALL_SEED_FILE")
    if seed and os.path.exists(seed):
        shell_cmd += f" \"$(cat '{seed}')\""
    open_in_terminal(shell_cmd, tab=tab, project=project, title=title)
    return new_id


# distinct, readable tab colors — same project always lands on the same one,
# so iTerm's left tab bar shows a colored stripe per project (visual grouping)
TAB_PALETTE = [
    (230, 64, 64),    # red
    (236, 128, 40),   # orange
    (226, 168, 44),   # amber
    (206, 196, 50),   # yellow
    (150, 202, 58),   # lime
    (74, 194, 90),    # green
    (46, 192, 158),   # teal
    (52, 186, 214),   # cyan
    (60, 152, 238),   # sky
    (78, 116, 240),   # blue
    (122, 110, 236),  # indigo
    (168, 96, 230),   # violet
    (214, 84, 208),   # magenta
    (234, 92, 156),   # pink
]


def tab_color(project):
    import zlib
    key = project_prefix(project)  # colour by the project FOLDER name, not the full path
    return TAB_PALETTE[zlib.crc32(key.encode()) % len(TAB_PALETTE)]  # → same folder = same stripe


def iterm_color_prefix(project):
    """iTerm OSC 6: paint the tab by project so the left bar groups visually."""
    if not project:
        return ""
    r, g, b = tab_color(project)
    return (f"printf '\\033]6;1;bg;red;brightness;{r}\\a"
            f"\\033]6;1;bg;green;brightness;{g}\\a"
            f"\\033]6;1;bg;blue;brightness;{b}\\a'; ")


def iterm_title_prefix(title):
    """OSC 0 so the tab shows recall's short «<emoji> <folder> · <task>» name. Only sticks
    when Claude Code's own title updates are off (CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1)."""
    if not title:
        return ""
    t = title.replace("\\", "").replace("'", "")
    return f"printf '\\033]0;{t}\\a'; "


def _iterm_ttys():
    """Every iTerm session's tty, across all windows/tabs."""
    osa = (
        'set out to ""\n'
        'tell application "iTerm2"\n'
        '  set wl to windows\n'
        '  repeat with wi from 1 to count of wl\n'
        '    set tl to tabs of (item wi of wl)\n'
        '    repeat with ti from 1 to count of tl\n'
        '      set sl to sessions of (item ti of tl)\n'
        '      repeat with si from 1 to count of sl\n'
        '        set out to out & (tty of (item si of sl)) & linefeed\n'
        '      end repeat\n'
        '    end repeat\n'
        '  end repeat\n'
        'end tell\n'
        'return out'
    )
    try:
        r = subprocess.run(["osascript", "-e", osa], capture_output=True, text=True, timeout=10)
    except Exception:
        return []
    return [ln.strip() for ln in (r.stdout or "").splitlines() if ln.strip().startswith("/dev/")]


def _tty_cwd(tty):
    """Working dir behind a tty: prefer the claude process, else the deepest shell."""
    dev = tty.rsplit("/", 1)[-1]
    try:
        ps = subprocess.run(["/bin/ps", "-t", dev, "-o", "pid=,comm="],
                            capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    claude_pid, others = None, []
    for line in ps.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        pid, comm = parts[0], parts[1].rsplit("/", 1)[-1]
        if comm == "claude":
            claude_pid = pid
        elif comm != "login":
            others.append(pid)
    for pid in ([claude_pid] if claude_pid else []) + list(reversed(others)):
        try:
            lf = subprocess.run(["/usr/sbin/lsof", "-a", "-d", "cwd", "-p", pid, "-Fn"],
                                capture_output=True, text=True, timeout=5)
        except Exception:
            continue
        for ln in lf.stdout.splitlines():
            if ln.startswith("n"):
                return ln[1:]
    return None


def _spread_colors(n):
    """n maximally-separated, DISTINCT colours from TAB_PALETTE."""
    p = len(TAB_PALETTE)
    if n <= 0:
        return []
    if n >= p:
        return [TAB_PALETTE[i % p] for i in range(n)]
    return [TAB_PALETTE[(i * p) // n] for i in range(n)]


def _osc6(rgb):
    r, g, b = rgb
    return (f"\033]6;1;bg;red;brightness;{r}\a"
            f"\033]6;1;bg;green;brightness;{g}\a"
            f"\033]6;1;bg;blue;brightness;{b}\a")


def cmd_regroup(quiet=False):
    """Set-aware tab colouring: every OPEN project folder gets a DISTINCT colour, so a
    fixed-palette hash can never collide two live projects (the birthday paradox a plain
    per-folder hash always risks). Wired into `recall open`; also run by hand: `recall regroup`."""
    if os.environ.get("RECALL_TERMINAL", "Terminal").lower() != "iterm":
        if not quiet:
            print("regroup is iTerm-only (set RECALL_TERMINAL=iterm)")
        return {}
    pairs = []
    for tty in _iterm_ttys():
        cwd = _tty_cwd(tty)
        if cwd:
            pairs.append((tty, project_prefix(cwd)))
    folders = sorted({f for _, f in pairs})
    cmap = {f: c for f, c in zip(folders, _spread_colors(len(folders)))}
    done = 0
    for tty, folder in pairs:
        try:
            with open(tty, "w") as fh:
                fh.write(_osc6(cmap[folder]))
            done += 1
        except OSError:
            pass
    if not quiet:
        print(f"regrouped {done} tab(s) across {len(folders)} project(s) — one distinct colour each")
    return cmap


def open_in_terminal(shell_cmd, tab=False, project=None, title=None):
    if title:                       # OSC-0 title so the tab shows recall's short name
        shell_cmd = iterm_title_prefix(title) + shell_cmd
    term = os.environ.get("RECALL_TERMINAL", "Terminal")
    if term.lower() == "iterm":
        # iTerm tabs are first-class AppleScript citizens; fall back to a
        # window when there is no window to put a tab in. Prefix an OSC-6
        # color so same-project tabs share a stripe in the vertical tab bar.
        esc = (iterm_color_prefix(project) + shell_cmd).replace(
            "\\", "\\\\").replace('"', '\\"')
        mk = ('try\ntell current window to create tab with default profile\n'
              'on error\ncreate window with default profile\nend try'
              if tab else 'create window with default profile')
        script = (f'tell application "iTerm"\nactivate\n{mk}\n'
                  f'tell current session of current window to write text "{esc}"\nend tell')
        subprocess.run(["osascript", "-e", script], check=True, capture_output=True)
        print(f"opened in iTerm {'tab' if tab else 'window'} (color by project): {shell_cmd}")
        if os.environ.get("RECALL_REGROUP", "1") != "0":
            import time
            time.sleep(1.5)  # let the new shell `cd` land, then recolour every tab distinctly
            try:
                cmd_regroup(quiet=True)
            except Exception:
                pass
        return
    esc = shell_cmd.replace("\\", "\\\\").replace('"', '\\"')
    if tab:
        # Terminal.app has no native "new tab" verb — emulate cmd+T via System
        # Events (needs the Accessibility permission). osascript's exit code is
        # NOT a success signal here: the keystroke "succeeds" even when no tab is
        # born, and a blind `do script ... in selected tab of front window` would
        # then run the command inside whatever busy tab is frontmost (injecting
        # it into a live claude). So count tabs around the keystroke and only use
        # the tab if one actually appeared; otherwise fall back to a fresh window.
        script = (
            'tell application "Terminal"\n'
            '  activate\n'
            '  reopen\n'
            '  set n0 to count of tabs of front window\n'
            'end tell\n'
            'tell application "System Events" to tell process "Terminal"\n'
            '  set frontmost to true\n'
            '  keystroke "t" using command down\n'
            'end tell\n'
            'delay 0.6\n'
            'tell application "Terminal"\n'
            '  if (count of tabs of front window) > n0 then\n'
            f'    do script "{esc}" in selected tab of front window\n'
            '    return "tab"\n'
            '  else\n'
            f'    do script "{esc}"\n'
            '    return "window"\n'
            '  end if\n'
            'end tell')
        r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
        where = (r.stdout or "").strip()
        if where == "tab":
            print(f"opened in Terminal tab: {shell_cmd}")
            return
        if where == "window":
            print("tab didn't open (grant Terminal the Accessibility permission in "
                  "System Settings -> Privacy & Security) — opened a window instead")
            return
        # osascript itself errored (no front window, etc.) — plain new window below
    script = f'tell application "Terminal"\nactivate\ndo script "{esc}"\nend tell'
    subprocess.run(["osascript", "-e", script], check=True, capture_output=True)
    print(f"opened in Terminal window: {shell_cmd}")


def cmd_remove(id_prefix):
    idx = os.path.join(DATA, "INDEX.md")
    index_lines = open(idx, encoding="utf-8").read().splitlines() if os.path.exists(idx) else []
    cards = [p for p in glob.glob(os.path.join(DATA, f"{id_prefix}*.md")) if not p.endswith("INDEX.md")]
    line_hits = [l for l in index_lines if l.startswith(id_prefix)]
    ids = {os.path.basename(c)[:8] for c in cards} | {l.split()[0] for l in line_hits if l.split()}
    if not ids:
        sys.exit(f"recall: nothing to remove for id '{id_prefix}'")
    if len(ids) > 1:
        sys.exit("recall: ambiguous id, matches:\n  " + "\n  ".join(sorted(ids)))
    id8 = ids.pop()
    for c in cards:
        os.remove(c)
    if line_hits:
        with open(idx, "a+", encoding="utf-8") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.seek(0)
            kept = [l for l in f.read().splitlines() if l.strip() and not l.startswith(id8)]
            f.seek(0)
            f.truncate()
            f.write("\n".join(kept) + ("\n" if kept else ""))
    # tombstone so hook/backfill won't resurrect it (recall recap --force undoes)
    if id8 not in removed_ids():
        with open(REMOVED, "a", encoding="utf-8") as f:
            f.write(id8 + "\n")
    print(f"removed {id8}: card {'✓' if cards else '—'}, index line {'✓' if line_hits else '—'}, tombstoned")


def cmd_hook():
    try:
        transcript = json.load(sys.stdin).get("transcript_path", "")
    except Exception:
        return
    if not os.path.isfile(transcript):
        return
    archive_one(transcript)  # back up immediately (SessionEnd/PreCompact), before any cleanup can delete it
    with open(transcript, errors="replace") as f:
        if sum(1 for _ in f) < MIN_EVENTS:
            return
    subs = ["recap"]
    if handoff_enabled():  # handoff too: a spawn-resumed session wakes up informed
        subs.append("handoff")
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as log:
        for sub in subs:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), sub, transcript],
                             stdout=log, stderr=log, start_new_session=True)


def cmd_backup_hook():
    """Stop entrypoint: back up THIS session's transcript after every turn. Closes the
    gap between the 30-min archive sweep and the compact/SessionEnd hooks — an unclean
    death (folder moved/trashed, hard kill) before either still leaves a fresh copy.
    Cheap: archive_one is incremental (copies only on size/mtime change). Never blocks."""
    try:
        transcript = json.load(sys.stdin).get("transcript_path", "")
    except Exception:
        return
    if os.path.isfile(transcript):
        archive_one(transcript)


def cmd_backfill(days=180, min_events=25, jobs=4):
    from concurrent.futures import ThreadPoolExecutor
    import time
    cutoff = time.time() - days * 86400
    targets = []
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        name = os.path.basename(path)
        if name.startswith("agent-") or os.path.getmtime(path) < cutoff:
            continue
        if last_activity(path) < cutoff:
            continue
        with open(path, errors="replace") as f:
            if sum(1 for _ in f) >= min_events:
                targets.append(path)
    print(f"backfill: {len(targets)} sessions (days<={days}, events>={min_events}, jobs={jobs})",
          flush=True)
    with ThreadPoolExecutor(max_workers=jobs) as ex:
        for fut in [ex.submit(cmd_recap, t) for t in targets]:
            try:
                fut.result()
            except Exception as e:
                print(f"error: {e}", file=sys.stderr)
    print("backfill done")


def card_paths():
    """Recap cards only — DATA also holds INDEX.md / TAGS.md, which are not cards."""
    return [p for p in glob.glob(os.path.join(DATA, "*.md"))
            if re.fullmatch(r"[0-9a-f-]{32,}\.md", os.path.basename(p))]


def first_user_line(path, cap=110):
    """First real user message of a transcript, streamed cheaply (stops early).
    None => recap-worker session (skip it entirely)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"type":"user"' not in line and '"type": "user"' not in line:
                    continue
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                c = (e.get("message") or {}).get("content")
                if isinstance(c, list):  # content blocks — take the first text block
                    c = next((b.get("text", "") for b in c
                              if isinstance(b, dict) and b.get("type") == "text"), "")
                if isinstance(c, str) and c.strip():
                    if RECAP_MARKER in c:
                        return None
                    if c.startswith("<") or c.startswith("Caveat:"):
                        continue
                    c = re.sub(r"\s+", " ", c).strip()
                    return c[:cap] + ("…" if len(c) > cap else "")
    except OSError:
        pass
    return ""


def cmd_sweep(days=14, llm=True, max_llm=8, quiet=False):
    """Crash-first registry maintenance, built for sessions that NEVER end cleanly
    (ноут отрубается — SessionEnd не срабатывает). Every run (LaunchAgent, 30 min):
      1. archive       — incremental transcript backup (what `recall archive` did)
      2. cheap lines   — every substantial transcript missing from INDEX gets a
                         zero-LLM [new] line NOW (id, local time, project, first
                         user request) => `find` sees a crashed session immediately
      3. LLM catch-up  — up to max_llm haiku calls: recap sessions with no card or
                         a card ≥1h staler than the transcript; same for handoffs
      4. prune         — expire old handoff cards
    Self-quiescing (fresh cards → no LLM calls) and overlap-safe (flock)."""
    import time
    os.makedirs(DATA, exist_ok=True)
    say = (lambda *a: None) if quiet else print
    lock = open(os.path.join(DATA, ".sweep.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say("sweep already running")
        return
    cmd_archive(quiet=True)
    cutoff = time.time() - days * 86400
    removed = removed_ids()
    idx_path = os.path.join(DATA, "INDEX.md")
    idx_lines = [l for l in open(idx_path, encoding="utf-8").read().splitlines() if l.strip()] \
        if os.path.exists(idx_path) else []
    idx_ids = {l.split()[0] for l in idx_lines}
    idx_new = {l.split()[0] for l in idx_lines if " [new] " in l}
    carded = {os.path.basename(p)[:8] for p in card_paths()}
    fresh = []
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        sid = os.path.basename(path)[:-len(".jsonl")]
        if sid.startswith("agent-") or sid[:8] in removed or os.path.getmtime(path) < cutoff:
            continue
        la = last_activity(path)
        if la < cutoff:
            continue
        with open(path, errors="replace") as f:
            if sum(1 for _ in f) < MIN_EVENTS:
                continue
        fresh.append((la, path, sid))
    fresh.sort(reverse=True)
    new_lines = 0
    from datetime import datetime
    for la, path, sid in fresh:
        if sid[:8] in carded or (sid[:8] in idx_ids and sid[:8] not in idx_new):
            continue
        first = first_user_line(path)
        if first is None:
            continue
        proj = re.sub(r"\s+", "_", os.path.basename((_session_cwd(path) or "?").rstrip("/")))
        stamp = datetime.fromtimestamp(la).strftime("%Y-%m-%dT%H:%M")
        update_index(sid, f"{sid[:8]} {stamp} {proj} [new] {first} {{}}")
        new_lines += 1
    done_llm = 0
    if llm and os.environ.get("RECALL_SWEEP_LLM", "1") != "0":
        stale = 3600
        for la, path, sid in fresh:
            if done_llm >= max_llm:
                break
            card = os.path.join(DATA, f"{sid}.md")
            try:
                if not os.path.exists(card):
                    cmd_recap(path)
                    done_llm += 1
                elif la - os.path.getmtime(card) > stale:
                    cmd_recap(path, force=True)
                    done_llm += 1
                hp = os.path.join(HANDOFFS, f"{sid}.md")
                if done_llm < max_llm and handoff_enabled() and \
                        (not os.path.exists(hp) or la - os.path.getmtime(hp) > stale):
                    cmd_handoff(path)
                    done_llm += 1
            except Exception as e:
                os.makedirs(os.path.dirname(LOG), exist_ok=True)
                with open(LOG, "a") as log:
                    log.write(f"sweep {sid[:8]}: {e}\n")
    prune_handoffs()
    say(f"sweep: {len(fresh)} fresh sessions, +{new_lines} cheap [new] lines, "
        f"{done_llm} LLM catch-ups (cap {max_llm})")


def cmd_reindex():
    """Rebuild INDEX.md from every recap card, no LLM: v2 lines with local time,
    #tags and block-style entities — heals every line older recaps wrote. Cheap
    [new] lines whose session has no card yet are kept as-is."""
    idx_path = os.path.join(DATA, "INDEX.md")
    old = [l for l in open(idx_path, encoding="utf-8").read().splitlines() if l.strip()] \
        if os.path.exists(idx_path) else []
    removed = removed_ids()
    lines = {}
    from datetime import datetime
    for p in card_paths():
        sid = os.path.basename(p)[:-len(".md")]
        if sid[:8] in removed:
            continue
        text = open(p, encoding="utf-8").read()
        grab = lambda k: (re.search(rf"^{k}:\s*(.+)$", text, re.M) or [None, ""])[1].strip()
        tr = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
        la = last_activity(tr[0]) if tr else os.path.getmtime(p)
        stamp = datetime.fromtimestamp(la).strftime("%Y-%m-%dT%H:%M")
        t = {"cwd": grab("project") or "?", "last_ts": stamp, "last_iso": "",
             "skills": [], "ai_texts": []}
        lines[sid[:8]] = index_line(sid, t, text)
    for l in old:  # keep cheap lines that still have no card
        id8 = l.split()[0]
        if id8 not in lines and " [new] " in l and id8 not in removed:
            lines[id8] = l
    out = sorted(lines.values(), key=lambda l: l.split()[1] if len(l.split()) > 1 else "",
                 reverse=True)
    with open(idx_path, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        f.truncate()
        f.write("\n".join(out) + "\n")
    print(f"reindex: {len(out)} lines from {len(card_paths())} cards")


def cmd_tags():
    from collections import Counter
    p = os.path.join(DATA, "TAGS.md")
    if os.path.exists(p):
        print(open(p, encoding="utf-8").read().rstrip() + "\n")
    else:
        print("no TAGS.md yet — vocabulary is free-form until one exists\n")
    idx = os.path.join(DATA, "INDEX.md")
    counts = Counter(re.findall(r"#([\wЀ-ӿ-]+)", open(idx, encoding="utf-8").read())) \
        if os.path.exists(idx) else Counter()
    print("usage in INDEX: " + ("  ".join(f"#{t}×{c}" for t, c in counts.most_common(40))
                                or "no tags yet"))


def cmd_doctor():
    import shutil
    ok = lambda c, msg: print(("  ✓ " if c else "  ✗ ") + msg) or bool(c)
    good = True
    good &= ok(shutil.which("claude"), "claude CLI on PATH")
    good &= ok(sys.version_info >= (3, 9), f"python3 >= 3.9 (have {sys.version.split()[0]})")
    idx = os.path.join(DATA, "INDEX.md")
    n = len(open(idx, encoding="utf-8").read().splitlines()) if os.path.exists(idx) else 0
    ok(n > 0, f"index: {n} sessions in {idx}")
    settings = os.path.expanduser("~/.claude/settings.json")
    stext = open(settings, encoding="utf-8").read() if os.path.exists(settings) else ""
    good &= ok("recall hook" in stext, "SessionEnd hook registered in ~/.claude/settings.json")
    ok("Bash(recall" in stext, "permissions: recall allowed without prompts (Bash(recall *))")
    if handoff_enabled():
        n_h = len(glob.glob(os.path.join(HANDOFFS, "*.md")))
        ok(True, f"handoff loop: ON — {n_h} live handoffs (auto-pruned after {HANDOFF_DAYS} days)")
    else:
        ok(True, "handoff loop: off (optional — enable: ./install.sh --with-handoff)")
    # coverage: a substantial recent transcript the index can't see = the exact
    # session `find` will miss after a dirty death (the wrong-resume bug)
    import time
    cutoff = time.time() - 7 * 86400
    idx_ids = {l.split()[0] for l in open(idx, encoding="utf-8") if l.strip()} \
        if os.path.exists(idx) else set()
    missing = 0
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        b = os.path.basename(path)
        if b.startswith("agent-") or os.path.getmtime(path) < cutoff:
            continue
        if b[:8] in idx_ids or b[:8] in removed_ids():
            continue
        with open(path, errors="replace") as f:
            if sum(1 for _ in f) >= MIN_EVENTS:
                if first_user_line(path) is None:  # recap-worker session — sweep skips it too
                    continue
                missing += 1
    good &= ok(missing == 0, f"index coverage (7d): {missing} substantial sessions missing"
               + (" — run `recall sweep`" if missing else ""))
    if sys.platform == "darwin":
        r = subprocess.run(["launchctl", "list", "com.andrey.recall-archive"],
                           capture_output=True)
        ok(r.returncode == 0, "LaunchAgent com.andrey.recall-archive loaded (30-min sweep)")
    sys.exit(0 if good else 1)


def cmd_index():
    idx = os.path.join(DATA, "INDEX.md")
    lines = open(idx, encoding="utf-8").read().splitlines() if os.path.exists(idx) else []
    by = {}
    for l in lines:
        m = re.search(r"\[(\w+)\]", l)
        by[m.group(1) if m else "?"] = by.get(m.group(1) if m else "?", 0) + 1
    print(f"{idx}\n{len(lines)} sessions  " + "  ".join(f"{k}: {v}" for k, v in sorted(by.items())))


USAGE = """recall {VERSION} — session memory & orchestration for Claude Code

  recall find <query...>        scored search: task×3 > #tags/entities×2 > project×1,
                                recency breaks ties; (meta)/#meta demoted; live
                                sessions flagged ⚡LIVE (address those, don't resume)
  recall grep <query...>        full-text search raw transcripts (fallback when index is silent)
  recall show <id8>             print a session's recap card
  recall cmd <id8>              print the resume command (handoff mode)
  recall open <id8> [--fast]    open in a new terminal window (spawn); refuses a
                    [--tab]     session that is ALREADY live (--force overrides);
                    [--force]   writes the missing handoff card first unless --fast;
                                --tab opens a tab instead (Terminal.app needs the
                                Accessibility permission; falls back to a window)
  recall sweep [--days N (14)]  crash-first registry upkeep (LaunchAgent, 30 min):
              [--no-llm]        archive + zero-LLM [new] index lines for unindexed
              [--max-llm N (8)] sessions + capped recap/handoff catch-up for stale
              [--quiet]         ones + prune (env RECALL_SWEEP_LLM=0 => no LLM ever)
  recall reindex                rebuild INDEX.md from cards (no LLM): time-of-day,
                                #tags, block-style entities healed
  recall tags                   tag vocabulary (TAGS.md) + usage counts in INDEX
  recall fork <id8> --at-line N branch a NEW session from line N of <id8>'s
                  [--anchor T]  transcript (or last line containing T); opens it
                  [--window]    (RECALL_SEED_FILE seeds an initial prompt)
  recall remove <id8>           forget a session: card + index line + tombstone
  recall rename <id8> <title>   set a session's display name by hand (auto-naming then leaves it alone)
  recall recap <file.jsonl>     recap one transcript [--force] (--force also un-removes)
  recall handoff <file.jsonl>   write a handoff card (in-flight state) for a session
  recall handoff --all          retro-sweep: handoffs for recent sessions lacking one
                                [--days N (14)] [--jobs N (4)]
  recall backfill               recap existing sessions [--days N] [--min-events N] [--jobs N]
  recall hook                   SessionEnd hook entrypoint (reads JSON on stdin)
  recall backup-hook            Stop hook entrypoint (stdin JSON; backs up this transcript)
  recall handoff-hook           PreCompact hook entrypoint (stdin JSON; sync)
  recall restore-hook           SessionStart hook entrypoint (stdin JSON; prints handoff)
  recall index                  index stats
  recall doctor                 check installation
  recall archive [dest]         durable append-only backup of every transcript jsonl OUT
                  [--quiet]      of the prune zone (default ~/backups/claude-transcripts);
                                 deleted originals stay recoverable here
  recall iterm-install          install the iTerm2 bridge into AutoLaunch (then enable
                                Python API in iTerm2 Settings → General → Magic + restart)
  recall ps                     list open Claude sessions by tty (via iTerm2 bridge)
  recall peek <ttyNNN> [lines]  read the current screen of one session
  recall send <ttyNNN> <text…>  send a prompt to ONE session (never broadcast; audited;
                                requires claude running on that tty)
  recall wait <ttyNNN> [secs]   block until that session goes idle (screen stabilises)
  recall regroup                iTerm: recolour every open tab so each project folder
                                gets a DISTINCT colour (set-aware; no hash collisions)

env: RECALL_DATA, RECALL_MODEL, RECALL_ARCHIVE (~/backups/claude-transcripts — durable transcript backup dir),
     RECALL_TERMINAL (Terminal|iTerm), RECALL_MIN_EVENTS,
     RECALL_HANDOFF_DAYS (default 30 — handoff retention),
     RECALL_AUTONAME (1 — auto-title «<эмодзи> <папка> · <задача>», ≤30 chars; 0 off),
     RECALL_REGROUP (1 — after `recall open`, recolour all iTerm tabs distinctly; 0 off),
     RECALL_TAB (1 — recall open defaults to tabs; per-call override: --window)"""


def _clone_or_copy(src, dst):
    """APFS clonefile (cp -pc) when possible: instant CoW, no data moved, zero extra
    disk while the original lives — yet a full independent copy that survives its
    deletion. Falls back to a real copy off-APFS/cross-volume. Writes via a tmp +
    atomic replace so a reader never sees a half-written backup."""
    import shutil
    tmp = dst + ".tmp"
    r = subprocess.run(["/bin/cp", "-pc", src, tmp], capture_output=True) \
        if sys.platform == "darwin" else None
    if r is None or r.returncode != 0:
        shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def archive_one(path):
    """Copy ONE transcript into ARCHIVE immediately (Stop/SessionEnd/PreCompact) so it
    survives even if something deletes the original before the periodic sweep runs."""
    try:
        d_dir = os.path.join(ARCHIVE, os.path.basename(os.path.dirname(path)))
        os.makedirs(d_dir, exist_ok=True)
        _clone_or_copy(path, os.path.join(d_dir, os.path.basename(path)))
    except OSError:
        pass


def archive_hit(sid):
    """Return a backed-up copy of a deleted transcript from ARCHIVE, if one exists."""
    g = glob.glob(os.path.join(ARCHIVE, "*", f"{sid}*.jsonl"))
    return g[0] if g else None


def orphan_artifacts(sid):
    """Transcript .jsonl is gone — report what survived so context can be reconstructed:
    the session's subagents/tool-results folder, the project's memory dir, and any
    archived copy of the transcript itself."""
    out = []
    for f in glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}*")):
        if not os.path.isdir(f):
            continue
        proj = os.path.basename(os.path.dirname(f))
        subs = glob.glob(os.path.join(f, "subagents", "*.meta.json"))
        trez = glob.glob(os.path.join(f, "tool-results", "*"))
        out.append(f"  artifacts: {f}")
        if subs:
            out.append(f"    {len(subs)} subagent metas (work descriptions survive)")
        if trez:
            out.append(f"    {len(trez)} tool-results")
        mem = os.path.join(PROJECTS_DIR, proj, "memory")
        if os.path.isdir(mem):
            out.append(f"    project memory: {mem}")
    arch = archive_hit(sid)
    if arch:
        out.append(f"  ✅ ARCHIVED COPY EXISTS: {arch}")
        out.append(f"     restore: cp '{arch}' '{os.path.join(PROJECTS_DIR, '<projecthash>')}/'")
    return "\n".join(out)


def cmd_archive(dest=None, quiet=False):
    """Durable, append-only backup of every transcript jsonl, OUT of the prune zone.
    recall is an INDEX over live ~/.claude/projects jsonl; Claude Code (or manual
    cleanup) deletes them, so we copy each <projecthash>/<id>.jsonl into ARCHIVE and
    NEVER delete from there — a deleted original stays recoverable. Incremental:
    copies only new/changed files (size or newer mtime)."""
    import shutil
    dest = os.path.expanduser(dest or ARCHIVE)
    os.makedirs(dest, exist_ok=True)
    new = upd = same = 0
    for s in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        proj = os.path.basename(os.path.dirname(s))
        d_dir = os.path.join(dest, proj)
        d = os.path.join(d_dir, os.path.basename(s))
        try:
            ss = os.stat(s)
            if os.path.exists(d):
                ds = os.stat(d)
                if ds.st_size == ss.st_size and int(ds.st_mtime) >= int(ss.st_mtime):
                    same += 1
                    continue
                upd += 1
            else:
                new += 1
            os.makedirs(d_dir, exist_ok=True)
            shutil.copy2(s, d)
        except OSError as e:
            if not quiet:
                print(f"  skip {os.path.basename(s)}: {e}")
    total = len(glob.glob(os.path.join(dest, "*", "*.jsonl")))
    if not quiet:
        print(f"recall archive → {dest}\n  +{new} new, ~{upd} updated, ={same} unchanged; "
              f"{total} transcripts archived (append-only; deleted originals stay here)")


# ── iTerm2 bridge client (addressable per-session control via a local queue) ──

def _iterm_job(op, wait_result=30.0, **fields):
    """Drop a job in the 0700 queue and wait for the bridge (running inside iTerm2)
    to write a result. The CLI never touches the iTerm2 API directly — no auth needed."""
    import time
    os.makedirs(ITERMQ, mode=0o700, exist_ok=True)
    try:
        os.chmod(ITERMQ, 0o700)
    except OSError:
        pass
    jid = f"{int(time.time() * 1000)}-{os.getpid()}"
    jf = os.path.join(ITERMQ, jid + ".job.json")
    rf = os.path.join(ITERMQ, jid + ".result.json")
    tmp = jf + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"id": jid, "op": op, **fields}, f, ensure_ascii=False)
    os.replace(tmp, jf)
    deadline = time.time() + wait_result
    while time.time() < deadline:
        if os.path.exists(rf):
            try:
                with open(rf, encoding="utf-8") as f:
                    res = json.load(f)
            except Exception:
                res = None
            for p in (rf, jf):
                try:
                    os.remove(p)
                except OSError:
                    pass
            if res is not None:
                return res
        time.sleep(0.2)
    try:
        os.remove(jf)
    except OSError:
        pass
    return {"ok": False, "error": "iterm-bridge not responding — enable iTerm2 Python API "
            "(Settings → General → Magic) + restart iTerm2, and run `recall iterm-install`"}


def cmd_iterm_ps():
    r = _iterm_job("ps")
    if not r.get("ok"):
        sys.exit("recall: " + r.get("error", "?"))
    rows = sorted(r.get("sessions", []), key=lambda d: d.get("short", ""))
    print(f"{'TTY':<6} {'CLAUDE':<7} {'SESSION':<10} FOLDER · TITLE")
    for d in rows:
        cl = "yes" if d.get("claude") else "—"
        sid = (d.get("claude_sid") or "")[:8]
        base = os.path.basename((d.get("cwd") or "").rstrip("/")) or "?"
        print(f"{d.get('short',''):<6} {cl:<7} {sid:<10} {base} · {d.get('title','')}")


def cmd_iterm_peek(tty, lines=40):
    r = _iterm_job("peek", tty=tty, lines=lines)
    if not r.get("ok"):
        sys.exit("recall: " + r.get("error", "?"))
    hdr = f"[{r.get('tty')}] claude={'yes' if r.get('claude') else '—'} {(r.get('claude_sid') or '')[:8]} {r.get('cwd','')}"
    print(hdr + "\n" + "─" * min(len(hdr), 80) + "\n" + r.get("screen", ""))


def cmd_iterm_send(tty, text):
    r = _iterm_job("send", tty=tty, text=text, wait_result=15.0)
    if not r.get("ok"):
        sys.exit("recall: " + r.get("error", "?"))
    print(f"✓ sent to {r.get('tty')} (claude {(r.get('claude_sid') or '?')[:8]})")


def cmd_iterm_wait(tty, timeout=300):
    r = _iterm_job("wait", tty=tty, timeout=timeout, wait_result=timeout + 15)
    if not r.get("ok"):
        sys.exit("recall: " + r.get("error", "?"))
    state = "idle" if r.get("idle") else "timeout (still busy)"
    print(f"[{r.get('tty')}] {state} — last screen:\n" + r.get("screen", ""))


def cmd_iterm_install():
    import shutil
    al = os.path.expanduser("~/Library/Application Support/iTerm2/Scripts/AutoLaunch")
    os.makedirs(al, exist_ok=True)
    here = os.path.dirname(os.path.realpath(__file__))  # realpath: resolve the ~/.local/bin symlink
    cands = [os.path.join(here, "iterm_bridge.py"),
             os.path.expanduser("~/.claude/recall/bin/iterm_bridge.py"),
             os.path.expanduser("~/dev/claude-recall/bin/iterm_bridge.py")]
    src = next((c for c in cands if os.path.exists(c)), None)
    if not src:
        sys.exit("recall: iterm_bridge.py not found (looked in: " + ", ".join(cands) + ")")
    dst = os.path.join(al, "recall_iterm_bridge.py")
    shutil.copy2(src, dst)
    print(f"✓ installed bridge → {dst}")
    print("Next:")
    print("  1. iTerm2 → Settings → General → Magic → ✅ Enable Python API")
    print("     (do NOT tick 'Allow all apps to connect')")
    print("  2. Restart iTerm2 (bridge auto-launches; approve it once if asked)")
    print("  3. Verify:  recall ps")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE.replace("{VERSION}", VERSION))
    elif args[0] in ("-v", "--version", "version"):
        print(VERSION)
    elif args[0] in ("find", "search") and len(args) > 1:
        cmd_find(args[1:])
    elif args[0] == "grep" and len(args) > 1:
        cmd_grep(args[1:])
    elif args[0] == "show" and len(args) > 1:
        print(card_meta(resolve_card(args[1]))["text"])
    elif args[0] == "cmd" and len(args) > 1:
        print(resume_command(args[1]))
    elif args[0] == "open" and len(args) > 1:
        tab = "--tab" in args or (os.environ.get("RECALL_TAB") == "1" and "--window" not in args)
        cmd_open(args[1], fast="--fast" in args, tab=tab, force="--force" in args)
    elif args[0] == "sweep":
        flag = lambda n, d: int(args[args.index(n) + 1]) if n in args else d
        cmd_sweep(days=flag("--days", 14), llm="--no-llm" not in args,
                  max_llm=flag("--max-llm", 8), quiet="--quiet" in args)
    elif args[0] == "reindex":
        cmd_reindex()
    elif args[0] == "tags":
        cmd_tags()
    elif args[0] == "fork" and len(args) > 1:
        flagv = lambda n: (args[args.index(n) + 1] if n in args and args.index(n) + 1 < len(args) else None)
        at = flagv("--at-line")
        tab = "--tab" in args or (os.environ.get("RECALL_TAB") == "1" and "--window" not in args)
        cmd_fork(args[1], at_line=int(at) if at else None, anchor=flagv("--anchor"), tab=tab)
    elif args[0] in ("remove", "rm", "forget") and len(args) > 1:
        cmd_remove(args[1])
    elif args[0] == "rename" and len(args) > 2:
        apply_title(find_transcript(args[1]), " ".join(args[2:]), manual=True)
    elif args[0] == "recap" and len(args) > 1:
        cmd_recap(args[1], force="--force" in args)
    elif args[0] == "backfill":
        flag = lambda n, d: int(args[args.index(n) + 1]) if n in args else d
        cmd_backfill(flag("--days", 180), flag("--min-events", 25), flag("--jobs", 4))
    elif args[0] == "handoff" and len(args) > 1:
        if args[1] == "--all":
            flag = lambda n, d: int(args[args.index(n) + 1]) if n in args else d
            cmd_handoff_all(flag("--days", 14), flag("--jobs", 4))
        else:
            cmd_handoff(args[1])
    elif args[0] == "hook":
        cmd_hook()
    elif args[0] == "backup-hook":
        cmd_backup_hook()
    elif args[0] == "handoff-hook":
        cmd_handoff_hook()
    elif args[0] == "restore-hook":
        cmd_restore_hook()
    elif args[0] == "index":
        cmd_index()
    elif args[0] == "doctor":
        cmd_doctor()
    elif args[0] in ("regroup", "recolor"):
        cmd_regroup()
    elif args[0] == "archive":
        rest = [a for a in args[1:] if not a.startswith("-")]
        cmd_archive(rest[0] if rest else None, quiet="--quiet" in args)
    elif args[0] == "ps":
        cmd_iterm_ps()
    elif args[0] == "peek" and len(args) > 1:
        cmd_iterm_peek(args[1], int(args[2]) if len(args) > 2 and args[2].isdigit() else 40)
    elif args[0] == "send" and len(args) > 2:
        cmd_iterm_send(args[1], " ".join(args[2:]))
    elif args[0] == "wait" and len(args) > 1:
        cmd_iterm_wait(args[1], int(args[2]) if len(args) > 2 and args[2].isdigit() else 300)
    elif args[0] in ("iterm-install", "iterm_install"):
        cmd_iterm_install()
    else:
        sys.exit(USAGE.replace("{VERSION}", VERSION))


if __name__ == "__main__":
    main()
